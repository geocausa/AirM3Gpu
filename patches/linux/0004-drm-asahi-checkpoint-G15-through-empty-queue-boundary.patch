+                // callbacks are still telemetry-only. This exercises the exact
+                // G15 Event/FWLog/KTrace/Stats parsers without racing a callback.
+                {
+                    let mut ch = mgr.rx_channels.lock();
+                    ch.fw_log.poll();
+                    ch.ktrace.poll();
+                    ch.stats.poll();
+                    ch.event.poll();

+static uint64_t
+hk_build_g15_eot_state_loader(struct hk_cmd_buffer *cmd,
+                              const VkRenderingInfo *info,
+                              struct agx_bg_eot_key *key,
+                              bool partial_render,
+                              bool incomplete_render_area)
+{
+   struct hk_device *dev = hk_cmd_buffer_device(cmd);
+
+   /*
+    * First bring-up gate: exactly the 25F84 class captured dynamically.
+    * Broaden only after each additional variant is independently validated.
+    */
+   if (dev->dev.params.gpu_generation != 15 || partial_render ||
+       incomplete_render_area || key->tib.layered ||
+       key->tib.nr_samples != 1 || key->tib.sample_size_B != 8 ||
+       key->tib.tile_size != 32 * 32 || agx_tilebuffer_spills(&key->tib))
+      return 0;
+
+   if (info->pDepthAttachment || info->pStencilAttachment)
+      return 0;
+
+   if (info->colorAttachmentCount < 1 || key->op[0] != AGX_EOT_STORE)
+      return 0;
+
+   for (unsigned rt = 0; rt < info->colorAttachmentCount; ++rt) {
+      const VkRenderingAttachmentInfo *att = &info->pColorAttachments[rt];
+
+      if (att->resolveMode != VK_RESOLVE_MODE_NONE)
+         return 0;
+
+      /* The captured ordinary eot_uber path has exactly RT0 active. */
+      if (rt > 0 && key->op[rt] != AGX_BG_EOT_NONE)
+         return 0;
+   }
+
+   struct hk_rendering_state *render = &cmd->state.gfx.render;
+   struct hk_image_view *iview = render->color_att[0].iview;
+   if (!iview)
+      return 0;
+
+   const enum pipe_format logical = key->tib.logical_format[0];
+   const struct ail_pixel_format_entry *fmt = &ail_pixel_format[logical];
+   uint8_t selector, components;
+   if (!agx_g15_eot_format_metadata(fmt->channels, fmt->type, &selector,
+                                    &components) ||
+       selector != 3 || components != 4)
+      return 0;
+
+   uint8_t ldshdr[AGX_G15_EOT_UBER_LDSHDR_SIZE];
+   if (!agx_g15_eot_ordinary_ldshdr(ldshdr, key->tib.sample_size_B, 32, 32,
+                                    key->tib.nr_samples))
+      return 0;
+
+   struct agx_ptr aux =
+      hk_pool_alloc(cmd, AGX_G15_EOT_UBER_AUX_SIZE, 64);
+   struct agx_ptr esl =
+      hk_pool_usc_alloc(cmd, AGX_G15_EOT_UBER_ESL_SIZE, 64);
+   if (!aux.cpu || !esl.cpu)
+      return 0;
+
+   static_assert(sizeof(struct agx_pbe_packed) == AGX_G15_EOT_PBE_SIZE,
+                 "G15 EOT PBE size");
+
+   uint8_t pbe[AGX_G15_EOT_MAX_RTS][AGX_G15_EOT_PBE_SIZE] = {{0}};
+   uint32_t format_words[AGX_G15_EOT_MAX_RTS] = {0};
+   memcpy(pbe[0], &iview->planes[0].eot, AGX_G15_EOT_PBE_SIZE);
+   format_words[0] = agx_g15_eot_format_word(
+      selector, components, agx_tilebuffer_offset_B(&key->tib, 0),
+      key->tib.sample_size_B, 2);
+
+   agx_g15_build_eot_uber_aux(aux.cpu, aux.gpu, pbe, format_words, 1,
+                              agx_g15_eot_ordinary_key_config(
+                                 key->tib.sample_size_B));
+   agx_g15_build_eot_uber_esl(esl.cpu, aux.gpu, ldshdr);
+
+   return esl.gpu;
+}
+
 static struct hk_bg_eot
 hk_build_bg_eot(struct hk_cmd_buffer *cmd, const VkRenderingInfo *info,
                 bool store, bool partial_render, bool incomplete_render_area)

diff --git a/src/asahi/lib/tests/test-g15-esl.cpp b/src/asahi/lib/tests/test-g15-esl.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..dfb500995a66c3fdba1ed6547792d8ba967fe34c
--- /dev/null
+++ b/src/asahi/lib/tests/test-g15-esl.cpp
@@ -0,0 +1,136 @@
+/* SPDX-License-Identifier: MIT */
+
+#include "agx_g15_esl.h"
+
+#include <gtest/gtest.h>
+#include <string.h>
+
+TEST(G15ESL, Copy0)
+{
+   const struct {
+      uint8_t dst, src;
+      bool gather;
+      uint32_t word;
+   } cases[] = {
+      {0x28, 0x04, false, 0x0409282b},
+      {0x66, 0x42, false, 0x0489661b},
+      {0x5e, 0x3a, false, 0x04495edb},
+      {0x40, 0x1c, false, 0x040940eb},
+      {0x00, 0x4a, true, 0x0481005b},
+      {0x00, 0x4e, true, 0x0481007b},
+   };
+
+   for (const auto &c : cases) {
+      uint8_t encoded[4];
+      agx_g15_esl_encode_copy0(encoded, c.dst, c.src, c.gather);
+
+      uint32_t word = encoded[0] | ((uint32_t)encoded[1] << 8) |
+                      ((uint32_t)encoded[2] << 16) |
+                      ((uint32_t)encoded[3] << 24);
+      ASSERT_EQ(word, c.word);
+   }
+}
+
+TEST(G15ESL, EOTUberRelocations)
+{
+   uint8_t out[AGX_G15_EOT_UBER_ESL_SIZE];
+   const uint8_t ldshdr[AGX_G15_EOT_UBER_LDSHDR_SIZE] = {
+      0x10, 0x21, 0x32, 0x43, 0x54, 0x65, 0x76, 0x87,
+   };
+   const uint64_t aux = 0x0000010000128600ULL;
+
+   ASSERT_EQ(agx_g15_build_eot_uber_esl(out, aux, ldshdr), sizeof(out));
+   ASSERT_EQ(out[4], (aux >> 6) & 0xff);
+   ASSERT_EQ(out[6], (aux >> 13) & 0xff);
+   ASSERT_EQ(out[12], (aux >> 18) & 0xff);
+   ASSERT_EQ(memcmp(out + AGX_G15_EOT_UBER_LDSHDR_OFFSET, ldshdr,
+                    sizeof(ldshdr)),
+             0);
+
+   /* The recovered ordinary path ends with the IOTO end marker. */
+   ASSERT_EQ(out[sizeof(out) - 4], 0x0e);
+   ASSERT_EQ(out[sizeof(out) - 3], 0x00);
+   ASSERT_EQ(out[sizeof(out) - 2], 0x00);
+   ASSERT_EQ(out[sizeof(out) - 1], 0x00);
+}
+
+
+TEST(G15ESL, EOTOrdinaryLdshdr)
+{
+   uint8_t out[AGX_G15_EOT_UBER_LDSHDR_SIZE];
+   const uint8_t captured[AGX_G15_EOT_UBER_LDSHDR_SIZE] = {
+      0x77, 0x00, 0x2a, 0x43, 0x4b, 0x00, 0x00, 0x00,
+   };
+
+   ASSERT_TRUE(agx_g15_eot_ordinary_ldshdr(out, 8, 32, 32, 1));
+   ASSERT_EQ(memcmp(out, captured, sizeof(captured)), 0);
+
+   /* The helper is deliberately scoped to the dynamically proven class. */
+   ASSERT_FALSE(agx_g15_eot_ordinary_ldshdr(out, 8, 32, 16, 1));
+   ASSERT_FALSE(agx_g15_eot_ordinary_ldshdr(out, 8, 32, 32, 4));
+   ASSERT_FALSE(agx_g15_eot_ordinary_ldshdr(out, 7, 32, 32, 1));
+}
+
+TEST(G15ESL, EOTFormatWords)
+{
+   ASSERT_EQ(agx_g15_eot_format_word(3, 4, 0, 8, 2), 0x10020300u);
+   ASSERT_EQ(agx_g15_eot_format_word(12, 4, 0, 8, 2), 0x10020c00u);
+   ASSERT_EQ(agx_g15_eot_ordinary_key_config(8), 0x00400081u);
+   ASSERT_EQ(agx_g15_eot_ordinary_key_config(16), 0x00400101u);
+}
+
+TEST(G15ESL, EOTUberAuxLayout)
+{
+   uint8_t out[AGX_G15_EOT_UBER_AUX_SIZE];
+   uint8_t pbe[AGX_G15_EOT_MAX_RTS][AGX_G15_EOT_PBE_SIZE] = {};
+   uint32_t formats[AGX_G15_EOT_MAX_RTS] = {};
+   const uint8_t captured_pbe[AGX_G15_EOT_PBE_SIZE] = {
+      0x22,0x0a,0xc6,0x3f,0xc0,0x0f,0x00,0x08,
+      0x00,0x80,0x00,0x00,0x10,0x00,0x00,0x80,
+      0x00,0x84,0x00,0x00,0x10,0x00,0x00,0x00,
+   };
+   memcpy(pbe[0], captured_pbe, sizeof(captured_pbe));
+   formats[0] = agx_g15_eot_format_word(3, 4, 0, 8, 2);
+   const uint64_t aux = 0x0000010000128600ULL;
+   ASSERT_EQ(agx_g15_build_eot_uber_aux(out, aux, pbe, formats, 1,
+                                        agx_g15_eot_ordinary_key_config(8)), sizeof(out));
+   uint64_t qword; uint32_t word;
+   memcpy(&qword, out + 0x000, 8); ASSERT_EQ(qword, aux + 0x20);
+   memcpy(&qword, out + 0x220, 8); ASSERT_EQ(qword, aux + 0x228);
+   ASSERT_EQ(memcmp(out + 0x020, captured_pbe, sizeof(captured_pbe)), 0);
+   memcpy(&word, out + 0x22c, 4); ASSERT_EQ(word, 0x10020300u);
+   memcpy(&word, out + 0x274, 4); ASSERT_EQ(word, 1u);
+   memcpy(&word, out + 0x278, 4); ASSERT_EQ(word, 0x00400081u);
+   memcpy(&word, out + 0x2bc, 4); ASSERT_EQ(word, 0xffffffffu);
+}
